[Unit]
Description=Z13: re-apply 80%% battery charge limit on user login
Documentation=file:///home/deck/z13/CLAUDE.md
After=default.target

[Service]
Type=oneshot
# z13ctl writes /sys/class/power_supply/.../charge_control_end_threshold via udev rule
ExecStart=/home/deck/.local/bin/z13ctl batterylimit --set 80
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

[Install]
WantedBy=default.target
