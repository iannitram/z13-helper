#!/usr/bin/env bash
# boondock — one-shot low-power mode for the Z13 (ROG Flow Z13 GZ302EA), off-grid use.
#
# `boondock on`   → cap TDP + quiet profile + dim screen + stop clearly-BACKGROUND
#                   power draws (local LLM stack). Snapshots prior state first.
# `boondock off`  → restore everything `on` changed (falls back to sane defaults
#                   if no snapshot exists).
# `boondock status` → show what's currently in effect.
#
# `on`/`off` are the two halves together. Profile hooks call only the SESSION half
# (`session-on` / `session-off`: screen + background services, no power hardware),
# because the profile engine already applied the profile's own TDP/base/fans.
# `hardware-on` / `hardware-off` are the standalone power half (quiet + 28/32/45 W).
#
# Background services are the only session workload this script pauses.
#
# Lives in ~/.local/bin (on /home) so it survives SteamOS atomic updates.
# Companion to z13ctl — folds into z13ctl natively later if we get a Go toolchain.
set -uo pipefail

# ---------- tunables ----------
# Paths are overridable from the environment so tests can run the script against stubs.
Z=${BOONDOCK_Z13CTL:-/home/deck/.local/bin/z13ctl}
ZP=${BOONDOCK_Z13_PROFILE:-/home/deck/.local/bin/z13-profile}
STATE=${BOONDOCK_STATE:-/home/deck/.local/state/boondock.state}
BL=${BOONDOCK_BACKLIGHT:-/sys/class/backlight/amdgpu_bl0}
BOONDOCK_BRIGHT_PCT=35                 # screen brightness in boondock mode
DEFAULT_RESTORE_PCT=80                 # brightness if we restore without a snapshot
# PPT (sustained/short/fast) in W: the asus-armoury floors, the lowest the firmware
# takes. Same numbers as BOONDOCK_TDP in src/profiles.py; keep them together (#203).
TDP_PL1=28; TDP_PL2=32; TDP_PL3=45
ARMOURY=${BOONDOCK_ARMOURY:-/sys/class/firmware-attributes/asus-armoury/attributes}
BG_SERVICES=(llama-swap)               # systemd services safe to stop off-grid
PROFILE_SYSFS=${BOONDOCK_PROFILE_SYSFS:-/sys/firmware/acpi/platform_profile}
# ------------------------------

mkdir -p "$(dirname "$STATE")"
bright_max() { cat "$BL/max_brightness"; }
set_bright_pct() { local pct=$1 max; max=$(bright_max); local v=$(( max * pct / 100 )); echo "$v" | sudo tee "$BL/brightness" >/dev/null; }
say() { printf '  %s\n' "$*"; }

# fit_rail VALUE ATTR: VALUE clamped into ATTR's min_value..max_value range metadata
# (never the live PPT value, ROADMAP principle 5). The firmware clamps an
# out-of-range write silently, so writing the fitted value is what lets the
# message below name the limit that applied. No metadata: VALUE unchanged.
fit_rail() {
  local v=$1 lo hi
  lo=$(cat "$ARMOURY/$2/min_value" 2>/dev/null) || lo=
  hi=$(cat "$ARMOURY/$2/max_value" 2>/dev/null) || hi=
  [[ $lo =~ ^[0-9]+$ ]] && [ "$v" -lt "$lo" ] && v=$lo
  [[ $hi =~ ^[0-9]+$ ]] && [ "$v" -gt "$hi" ] && v=$hi
  echo "$v"
}

# The active app profile and its stored TDP: never read live ppt_* values
# (ROADMAP principle 5). Empty when z13-profile is not installed.
profile_active() { [ -x "$ZP" ] && "$ZP" active 2>/dev/null; }
profile_tdp() {
  local name=$1 field=$2
  [ -n "$name" ] && [ -x "$ZP" ] || return 1
  "$ZP" show "$name" 2>/dev/null | python3 -c '
import json, sys
try:
    tdp = json.load(sys.stdin).get("tdp") or {}
except Exception:
    sys.exit(1)
value = tdp.get(sys.argv[1])
print("" if value is None else value)
' "$field" 2>/dev/null
}

# The state file holds two independent groups of keys: session keys (brightness, svc)
# and hardware keys (profile, pl1..pl3). Each operation rewrites only its own.
# Any key that is not a hardware key belongs to the session half, including keys an
# older version wrote and this one no longer uses.
SESSION_KEYS='brightness|svc'
HW_KEYS='profile|pl1|pl2|pl3'
state_drop() { [ -f "$STATE" ] && { grep -Ev "^($1)=" "$STATE" > "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }; return 0; }
state_keep() { [ -f "$STATE" ] && { grep -E "^($1)=" "$STATE" > "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }; return 0; }
state_has_session() { grep -E '^[^=]+=' "$STATE" 2>/dev/null | grep -Evq "^($HW_KEYS)="; }
state_get() { grep "^$1=" "$STATE" 2>/dev/null | cut -d= -f2; }
state_cleanup() { [ -f "$STATE" ] && [ ! -s "$STATE" ] && rm -f "$STATE"; return 0; }

# ---- session effects: profile-independent, touch NO power hardware ----
# This is what the built-in Boondock profile's hooks run (session-on / session-off). The
# profile engine has already applied the profile's own base, TDP and fans before the enter
# hook, so nothing here may select a firmware profile, write TDP or read PPT values.
do_session_on() {
  echo "🏕️  boondock session ON"

  # 1. snapshot current session state so `session-off` restores exactly
  state_drop "$SESSION_KEYS"
  {
    echo "brightness=$(cat "$BL/brightness" 2>/dev/null)"
    for s in "${BG_SERVICES[@]}"; do systemctl --user is-active "$s" >/dev/null 2>&1 && echo "svc=$s"; done
  } >> "$STATE"

  # 2. dim the screen
  set_bright_pct "$BOONDOCK_BRIGHT_PCT"; say "brightness → ${BOONDOCK_BRIGHT_PCT}%"

  # 3. stop BACKGROUND infra only (restartable services, not interactive sessions)
  #    (exactly the services the snapshot recorded as active, so `session-off` restarts the same set)
  for s in $(state_get svc); do systemctl --user stop "$s" && say "stopped service: $s"; done
  return 0
}

do_session_off() {
  echo "🔌 boondock session OFF — restoring"
  if state_has_session; then
    local b; b=$(state_get brightness)
    [ -n "$b" ]  && { echo "$b" | sudo tee "$BL/brightness" >/dev/null; say "brightness restored"; }
    for s in $(state_get svc); do systemctl --user start "$s" && say "restarted service: $s"; done
    # An older `boondock on` wrote hardware keys into the same snapshot. A profile hook
    # must not write power, so leave the hardware as is and clear the stale keys
    # (otherwise status reports ON forever and a later `off` restores old values).
    # A nonzero restore status from `off` keeps hardware keys for a retry.
    if [ "${1:-0}" -eq 0 ] && grep -Eq "^($HW_KEYS)=" "$STATE" 2>/dev/null; then
      state_drop "$HW_KEYS"; say "hardware snapshot found: power left as is, snapshot cleared"
    fi
  else
    say "no snapshot — restoring to defaults"
    set_bright_pct "$DEFAULT_RESTORE_PCT"; say "brightness → ${DEFAULT_RESTORE_PCT}%"
    for s in "${BG_SERVICES[@]}"; do systemctl --user start "$s" >/dev/null 2>&1 && say "started service: $s"; done
  fi
  # Clear every session key, including ones an older version wrote, without acting on them.
  state_keep "$HW_KEYS"
  state_cleanup
}

# ---- hardware: STANDALONE use only (the profile engine owns power for profiles) ----
# Never call from a profile hook: it would overwrite the profile's own TDP / base.
do_hw_on() {
  echo "🏕️  boondock hardware ON"
  state_drop "$HW_KEYS"
  local active p1 p2 p3
  active=$(profile_active)
  {
    if [ -n "$active" ]; then
      echo "profile=$active"
      p1=$(profile_tdp "$active" pl1); p2=$(profile_tdp "$active" pl2); p3=$(profile_tdp "$active" pl3)
      [ -n "$p1" ] && echo "pl1=$p1"
      [ -n "$p2" ] && echo "pl2=$p2"
      [ -n "$p3" ] && echo "pl3=$p3"
    else
      echo "profile=$(cat "$PROFILE_SYSFS" 2>/dev/null)"
    fi
  } >> "$STATE"
  # z13ctl only (no sudo, no sysfs writes): it has the udev/perms grants as deck.
  if ! "$Z" profile --set quiet >/dev/null 2>&1; then
    say "profile → quiet FAILED"
    return 1
  fi
  say "profile → quiet (low-power)"
  local tdp1 tdp2 tdp3
  tdp1=$(profile_tdp Boondock pl1); tdp1=${tdp1:-$TDP_PL1}
  tdp2=$(profile_tdp Boondock pl2); tdp2=${tdp2:-$TDP_PL2}
  tdp3=$(profile_tdp Boondock pl3); tdp3=${tdp3:-$TDP_PL3}
  tdp1=$(fit_rail "$tdp1" ppt_pl1_spl); tdp2=$(fit_rail "$tdp2" ppt_pl2_sppt)
  tdp3=$(fit_rail "$tdp3" ppt_pl3_fppt)
  [ "$tdp2" -lt "$tdp1" ] && tdp2=$tdp1
  [ "$tdp3" -lt "$tdp2" ] && tdp3=$tdp2
  if ! "$Z" tdp --set "$tdp1" --pl2 "$tdp2" --pl3 "$tdp3" >/dev/null 2>&1; then
    say "TDP → ${tdp1}/${tdp2}/${tdp3}W FAILED"
    return 1
  fi
  say "TDP → ${tdp1}W sustained / ${tdp2}W / ${tdp3}W boost"
}

do_hw_off() {
  echo "🔌 boondock hardware OFF — restoring"
  local p p1 p2 p3 restored_by_profile=0 rc=0
  p=$(state_get profile); p1=$(state_get pl1); p2=$(state_get pl2); p3=$(state_get pl3)
  if [ -n "$p$p1" ]; then
    case "$p" in
      quiet|balanced|performance)
        if "$Z" profile --set "$p" >/dev/null 2>&1; then
          say "profile → $p"
        else
          say "profile restore failed: $p"; rc=1
        fi
        ;;
      *)
        if [ -n "$p" ] && [ -x "$ZP" ] && "$ZP" apply "$p" >/dev/null 2>&1; then
          say "profile → $p (restored)"
          restored_by_profile=1
        elif [ -n "$p" ]; then
          say "profile restore failed: $p"; rc=1
        fi
        ;;
    esac
    if [ -n "$p1" ] && [ "$restored_by_profile" -eq 0 ]; then
      if "$Z" tdp --set "$p1" --pl2 "${p2:-$p1}" --pl3 "${p3:-$p1}" >/dev/null 2>&1; then
        say "TDP → ${p1}/${p2:-$p1}/${p3:-$p1}W"
      else
        say "TDP restore failed: ${p1}/${p2:-$p1}/${p3:-$p1}W"; rc=1
      fi
    fi
    # Keep the snapshot when anything failed, so a retry can still restore it.
    [ "$rc" -eq 0 ] && state_drop "$HW_KEYS"
  else
    say "no snapshot — restoring to defaults"
    if "$Z" profile --set balanced >/dev/null 2>&1; then
      say "profile → balanced (firmware TDP)"
    else
      say "profile → balanced FAILED"; rc=1
    fi
  fi
  state_cleanup
  return "$rc"
}

# `on` / `off` (by hand): both halves, as before.
do_on()  { local rc=0; do_hw_on || rc=1; do_session_on "$@"; echo "  → run 'boondock off' when you're back on power."; return "$rc"; }
do_off() { local rc=0; do_hw_off || rc=1; do_session_off "$rc"; echo "  → beast mode restored."; return "$rc"; }

do_status() {
  local max cur pct; max=$(bright_max); cur=$(cat "$BL/brightness"); pct=$(( cur * 100 / max ))
  echo "boondock status:"
  say "brightness: ${pct}%   profile: $(cat "$PROFILE_SYSFS" 2>/dev/null)"
  for s in "${BG_SERVICES[@]}"; do say "service $s: $(systemctl --user is-active "$s" 2>/dev/null)"; done
  [ -f "$STATE" ] && say "MODE: boondock ON (snapshot present)" || say "MODE: normal (no snapshot)"
}

case "${1:-status}" in
  on)     shift; do_on "$@";;
  off)    do_off;;
  session-on)  shift; do_session_on "$@";;     # profile hooks: no power hardware
  session-off) do_session_off;;
  hardware-on)  do_hw_on;;                     # standalone only
  hardware-off) do_hw_off;;
  status) do_status;;
  *) echo "usage: boondock {on|off|session-on|session-off|hardware-on|hardware-off|status}"; exit 1;;
esac
